@article{SLiM,
title = {State-wise linear modulation (SLim): A novel approach for steering large language models},
journal = {Neural Networks},
volume = {199},
pages = {108708},
year = {2026},
issn = {0893-6080},
doi = {https://doi.org/10.1016/j.neunet.2026.108708},
url = {https://www.sciencedirect.com/science/article/pii/S089360802600170X},
author = {Basavaraj {Sangayya Hiremath} and Marco Polignano and Marco Levantesi and Giovanni Semeraro and Ernesto William {De Luca} and Amos Poznanski},
keywords = {Large language models, Steering vectors, Activation shifting, Personalization, Deep learning, Natural language processing},
abstract = {The new decade breakthrough Large Language Models (LLMs), trained on extensive text corpora, have achieved remarkable advancements in NLP, demonstrating sophisticated language comprehension and text generation capabilities. However, for effective human-AI interaction, text generation at the lexical level alone is not sufficient. Advanced AI systems must be adaptable to users on an affective and emotional level, supporting interactions that involve empathy, regulation, and decision-making. Prompt engineering, currently the primary method for steering model behavior, has proven valuable but exhibits limited reliability and scope. Simply posing a question does not maximize the model’s performance, as demonstrated by techniques such as “step-by-step” prompting, which significantly enhances model output on various tasks. This work investigates how modifying the internal states of LLMs can guide output characteristics. Through a series of experiments using datasets labeled with sentiment, emotion, and other stylistic attributes, we demonstrate how specific state or style based vectors–representing parameters can scale and shift LLM activations to produce output that aligns with these attributes. Results show that the state-engineered outputs are more pronounced when prompted with subjective inputs compared to factual ones. This work thus contributes to bridging the gap between LLM capabilities and the nuanced demands of human-AI interaction, offering a new direction for controlling LLM outputs.}
}

