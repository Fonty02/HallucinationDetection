universe = vanilla
executable = scripts/O4A/run_save_activations.sh
request_cpus = 8
request_gpus = 1
log = logs/save_activations_htc/job_$(Cluster)_$(Process).log
output = logs/save_activations_htc/job_$(Cluster)_$(Process).out
error = logs/save_activations_htc/job_$(Cluster)_$(Process).err
arguments = "gemma_bb_facts None cuda:0"
queue
arguments = "gemma_bb_constraints None cuda:0"
queue
arguments = "gemma_halu None cuda:0"
queue
arguments = "llama_bb_facts None cuda:0"
queue
arguments = "llama_bb_constraints None cuda:0"
queue
arguments = "llama_halu None cuda:0"
queue
