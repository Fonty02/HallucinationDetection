universe = vanilla
executable = scripts/O4A_experiments/run_one4all_halueval_qwen_falcon.sh
request_cpus = 8
request_gpus = 1
request_memory = 32768
log = logs/run_experiments_htc/one4all_halueval_qwen_falcon_$(Cluster)_$(Process).log
output = logs/run_experiments_htc/one4all_halueval_qwen_falcon_$(Cluster)_$(Process).out
error = logs/run_experiments_htc/one4all_halueval_qwen_falcon_$(Cluster)_$(Process).err

# Seed unico (cambia qui se vuoi un altro seed)
SEED = 42

arguments = "$(SEED) cuda:0 8 true 4 true true false $(LAYER_TYPE)"
queue LAYER_TYPE from (
  attn
  mlp
  hidden
)
