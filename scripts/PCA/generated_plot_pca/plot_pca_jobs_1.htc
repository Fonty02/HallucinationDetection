universe = vanilla
executable = scripts/PCA/run_plot_pca.sh
request_cpus = 4
request_gpus = 0
request_memory = 16 GB
log = logs/plot_pca_htc/job_$(Cluster)_$(Process).log
output = logs/plot_pca_htc/job_$(Cluster)_$(Process).out
error = logs/plot_pca_htc/job_$(Cluster)_$(Process).err
arguments = "Qwen2.5-7B belief_bank_constraints:16,belief_bank_facts:15,halu_eval:8 attn 1500 true false results/pca_multidataset pca_Qwen2.5-7B_attn_belief_bank_constraints-16_belief_bank_facts-15_halu_eval-8_seed42.png 42 activation_cache"
queue
arguments = "Qwen2.5-7B belief_bank_constraints:16,belief_bank_facts:15,halu_eval:5 mlp 1500 true false results/pca_multidataset pca_Qwen2.5-7B_mlp_belief_bank_constraints-16_belief_bank_facts-15_halu_eval-5_seed42.png 42 activation_cache"
queue
arguments = "Qwen2.5-7B belief_bank_constraints:18,belief_bank_facts:22,halu_eval:7 hidden 1500 true false results/pca_multidataset pca_Qwen2.5-7B_hidden_belief_bank_constraints-18_belief_bank_facts-22_halu_eval-7_seed42.png 42 activation_cache"
queue
